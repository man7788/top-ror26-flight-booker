<li id="<%= dom_id passenger %>" data-delete-target="passenger">
  <%= passenger.name %>

  <div data-delete-target="form">
    <%= form_with url: passenger_path(passenger), method: :delete do |f| %>
      <%= f.button "Delete", data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
</li>
